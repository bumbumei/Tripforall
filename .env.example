# 한국관광공사 TourAPI 4.0 인증키 (data.go.kr 발급)
# 같은 키가 행안부 식당 API, 관광공사 웰니스/반려동물/집중률 API에 모두 사용됨.
TOUR_API_KEY=

# 한국문화정보원 (KCISA) 시티투어 맛집 API 키 (UUID, 별도 발급)
KCISA_API_KEY=

# LLM 키 — 하나만 있으면 됨. 우선순위: OpenRouter → OpenAI → Anthropic.
# 셋 다 없으면 결정론적 fallback 결과로 화면은 정상 동작 (narrative 단순).

# OpenRouter (가장 권장: 무료 모델 다수, paid 모델도 통합 제공)
# 모델 예시:
#  - google/gemma-4-31b-it:free   (무료, 빠름)
#  - meta-llama/llama-3.3-70b-instruct:free  (무료)
#  - anthropic/claude-3.5-sonnet  (paid)
#  - openai/gpt-4o                (paid)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# (선택) OpenRouter 리더보드 노출용
OPENROUTER_REFERER=https://tripforall.local
OPENROUTER_TITLE=TripForAll

# OpenAI 직접 호출 (OpenRouter 안 쓸 때)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic 직접 호출 (둘 다 없을 때 폴백)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# 데모 모드 (TourAPI 키 없을 때 mock 데이터 사용)
USE_MOCK_TOUR_API=true
