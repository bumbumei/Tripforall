# 한국관광공사 TourAPI 4.0 인증키 (data.go.kr 발급)
# 같은 키가 행안부 식당 API, 관광공사 웰니스/반려동물/집중률 API에 모두 사용됨.
TOUR_API_KEY=

# 한국문화정보원 (KCISA) 시티투어 맛집 API 키 (UUID, 별도 발급)
KCISA_API_KEY=

# LLM 키 — 하나만 있으면 됨. 우선순위: Ennoia → OpenRouter → OpenAI → Anthropic.
# 모두 없으면 결정론적 fallback 결과로 화면은 정상 동작 (narrative 단순).

# Ennoia (경진대회 필수 플랫폼) — 4개 모두 있어야 활성.
# 엔드포인트: POST https://api.ennoia.so/api/preset/v2/chat/completions
# 인증: 헤더 project + apiKey + X-ENNOIA-USER-ID
ENNOIA_API_KEY=
# 프로젝트 식별자 (예: KNTO-PROMPTON-2026-330)
ENNOIA_PROJECT=
# Studio에서 만든 preset의 SHA-256 hash (시스템 프롬프트가 preset에 내장)
ENNOIA_PRESET_HASH=
# Ennoia 내부 user UUID (32-char hex, 이메일 아님). MCP 인증 키가 등록된 사용자.
# Studio의 "배포 ▾ > 코드 보기" 또는 deploy log의 user_id 필드에서 확인.
ENNOIA_USER_ID=
# 선택: 기본 SaaS 엔드포인트와 다를 때만 (on-prem 등)
ENNOIA_BASE_URL=

# OpenRouter (무료 모델 다수, paid 모델도 통합 제공)
# 모델 예시:
#  - google/gemma-4-31b-it:free   (무료, 빠름)
#  - meta-llama/llama-3.3-70b-instruct:free  (무료)
#  - anthropic/claude-3.5-sonnet  (paid)
#  - openai/gpt-4o                (paid)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# (선택) OpenRouter 리더보드 노출용
OPENROUTER_REFERER=https://tripforall.local
OPENROUTER_TITLE=TripForAll

# OpenAI 직접 호출 (OpenRouter 안 쓸 때)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic 직접 호출 (둘 다 없을 때 폴백)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# 데모 모드 (TourAPI 키 없을 때 mock 데이터 사용)
USE_MOCK_TOUR_API=true
